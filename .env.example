# =============================================================================
# KoreAI environment template
# Copy this file to .env.local and fill in your values.
# Never commit .env.local (it is already listed in .gitignore).
# =============================================================================

# Required – obtain a key at https://build.nvidia.com
QWEN_API_KEY=your_api_key_here

# Optional – defaults shown
QWEN_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Enable chain-of-thought / reasoning mode on models that support it.
# Light tier always forces this off for speed. Default: false
QWEN_ENABLE_THINKING=false

# -----------------------------------------------------------------------------
# Model routing (comma-separated, tried in order)
# Run `npm run check-models` to discover which IDs work with your key.
# -----------------------------------------------------------------------------
KORE_LIGHT_MODELS=poolside/laguna-xs-2.1,nvidia/nemotron-3.5-lightning-30b-a3b,openai/gpt-oss-20b
KORE_MEDIUM_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,poolside/laguna-xs-2.1,openai/gpt-oss-20b
KORE_HEAVY_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,openai/gpt-oss-20b,z-ai/glm-5.3
